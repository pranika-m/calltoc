# LLM provider (OpenAI-compatible: OpenAI, Groq, Gemini, Ollama, etc.)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

# Voice providers
DEEPGRAM_API_KEY=your_deepgram_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sales_voice_agent

# Lead scoring thresholds (pure Python rules in crm.py)
LEAD_HOT_THRESHOLD=70
LEAD_WARM_THRESHOLD=40

# App
APP_ENV=development
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=en
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Telephony (Twilio - Phase 9)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
